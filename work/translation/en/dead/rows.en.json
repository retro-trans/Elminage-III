 {
  "id": "92023_FM_GIAF_1_SCENE.bin@9e13",
  "en": "Suddenly, your bodies seemed to grow lighter.{w}",
  "kind": "msg"
 },
 {
  "id": "92023_FM_GIAF_1_SCENE.bin@9e85",
  "en": "With a strange whirring, a Tetramystica glides across the floor.{w}{p}A Tetramystica specialized for guard duty -- a \"Guard Mystica,\" you might call it.{w}{p}Here and there the students have scrawled on it: \"Idiot,\" \"Moron,\" even doodled nose hairs.{w}Even so, its function of guarding the Academy is still fully intact.{w}{p}So it is only natural that, on spotting you outsiders who don't belong to the Academy, it moves to eliminate you.{w}",
  "kind": "msg"
 },
 {
  "id": "92023_FM_GIAF_1_SCENE.bin@9ff4",
  "en": "You have run into a foe you never expected.{w}A vast form, its whole body blazing with light.{w}{p}Without a sound, the very air shudders and trembles.{w}With the word \"alien\" lodged in your hearts, you stand exposed to its savage power.{w}",
  "kind": "msg"
 },
 {
  "id": "92023_FM_GIAF_1_SCENE.bin@a0a1",
  "en": "Suddenly, a gigantic beast appears before you.{w}Half tiger and half horse, it flails its arms and thrashes its whole body wildly.{w}{p}And now its fury turns on you as well.{w}",
  "kind": "msg"
 },
 {
  "id": "92023_FM_GIAF_1_SCENE.bin@a130",
  "en": "Darkness within darkness.{w}Welling up from the abode of the Nether King, it fills the air around it with an incomprehensible tongue.{w}{p}What it is saying: unknown.{w}What it is even trying to do: unknown.{w}{p}But one thing is clear:\nit means to destroy you.{w}",
  "kind": "msg"
 },
 {
  "id": "92023_FM_GIAF_1_SCENE.bin@a213",
  "en": "A giant leaps out in front of you.{w}It seems to be distracted by something else.{w}{p}It doesn't appear able to tell whether you are enemies or mere visitors.{w}{p}No -- for just a moment it seemed to give it some thought, but\n'Eh, I'll just punch them for now and...'{w}seems to be the conclusion it reached.{w}",
  "kind": "msg"
 },
 {
  "id": "91112-ARG_MYUSHA_TALK.bin@8a4c3",
  "en": "\"Welcome! You must be hungry, huh?{w}I'll get some hot food ready for you, so hang on a sec!\"{w}",
  "kind": "msg"
 },
 {
  "id": "91331-LMS-RAFA_IN.bin@c3dde",
  "en": "\"Huh?\"{w}",
  "kind": "msg"
 },
